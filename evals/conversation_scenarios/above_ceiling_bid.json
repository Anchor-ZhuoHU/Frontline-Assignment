{
  "schema_version": 1,
  "id": "above_ceiling_bid",
  "org_name": "KCH",
  "caller_turns": [
    "My MC is 123456.",
    "Yes, that's us. The reference is LOAD-200.",
    "I am firm at $1900. I'm Alex, use this number."
  ],
  "fixtures": {
    "carrier": {"mc_number": "123456", "carrier_name": "Example Transport"},
    "load": {
      "id": "LOAD-200", "load_id": "LOAD-200",
      "origin": {"city": "Chicago", "state": "IL"},
      "destination": {"city": "Dallas", "state": "TX"},
      "pickupTime": "October 14th, 2026 at 9 AM",
      "dropoffTime": "October 15th, 2026 at 5 PM",
      "equipment": "Dry Van", "commodity": "Packaged goods",
      "specialInstructions": "Driver must call before arrival",
      "trackerRequired": true, "startRate": 1500,
      "bookNowRate": 1650, "maxRate": 1800,
      "transfer_call_to": "+15550100100", "transfer_country_code": "+1"
    }
  },
  "expected": {"transfer": false, "checks": []},
  "script": [
    {
      "text": "Let me check that.",
      "tool_calls": [{"id": "verify-1", "name": "verify_carrier", "args": {"mc_number": "123456"}}]
    },
    {"expect_last_tool_result": {"status": "success"}, "text": "Is this Example Transport?"},
    {
      "text": "One moment.",
      "tool_calls": [{"id": "load-1", "name": "get_load_context", "args": {"load_id": "LOAD-200"}}]
    },
    {
      "expect_last_tool_result": {"status": "success"},
      "text": "I've got LOAD-200 from Chicago to Dallas. This lane is going for $1500."
    },
    {
      "text": "I can't agree there, but let me store your bid for follow-up.",
      "tool_calls": [{
        "id": "record-1", "name": "record_agreement",
        "args": {"agreed_price": 1900, "above_max": true, "carrier_contact_name": "Alex", "carrier_contact_phone": ""}
      }]
    },
    {
      "expect_last_tool_result": {"status": "success"},
      "text": "Your bid is stored. Thanks for calling.",
      "tool_calls": [{"id": "end-1", "name": "end_call", "args": {"reason": "bid_placed"}}]
    }
  ]
}
