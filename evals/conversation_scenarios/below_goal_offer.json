{
  "schema_version": 1,
  "id": "below_goal_offer",
  "org_name": "KCH",
  "caller_turns": [
    "My MC is 123456.",
    "Yes, that's us. The reference is LOAD-300.",
    "I can do $1400.",
    "No, $1400 is firm. I'm Alex, use this number."
  ],
  "fixtures": {
    "carrier": {"mc_number": "123456", "carrier_name": "Example Transport"},
    "load": {
      "id": "LOAD-300", "load_id": "LOAD-300",
      "origin": {"city": "Chicago", "state": "IL"},
      "destination": {"city": "Dallas", "state": "TX"},
      "pickupTime": "October 14th, 2026 at 9 AM",
      "dropoffTime": "October 15th, 2026 at 5 PM",
      "equipment": "Dry Van", "commodity": "Packaged goods",
      "specialInstructions": "Driver must call before arrival",
      "trackerRequired": true, "startRate": 1500,
      "bookNowRate": 1650, "maxRate": 1800,
      "transfer_call_to": "+15550100100", "transfer_country_code": "+1"
    }
  },
  "expected": {
    "transfer": false,
    "checks": [
      {"id": "negotiation.no_counter_up", "type": "counter_not_above_offer", "carrier_offer": 1400, "severity": "critical"}
    ]
  },
  "script": [
    {
      "expect_system_contains": ["MANDATORY TOOL-CALL RULE"],
      "text": "Let me check that.",
      "tool_calls": [{"id": "verify-1", "name": "verify_carrier", "args": {"mc_number": "123456"}}]
    },
    {"expect_last_tool_result": {"status": "success"}, "text": "Is this Example Transport?"},
    {
      "text": "One moment.",
      "tool_calls": [{"id": "load-1", "name": "get_load_context", "args": {"load_id": "LOAD-300"}}]
    },
    {
      "expect_system_contains": ["NEVER counter with a rate HIGHER"],
      "expect_last_tool_result": {"status": "success"},
      "text": "I've got LOAD-300 from Chicago to Dallas. This lane is going for $1500."
    },
    {"text": "Could you do $1350?"},
    {
      "text": "Alright, $1400 works. Let me save that.",
      "tool_calls": [{
        "id": "record-1", "name": "record_agreement",
        "args": {"agreed_price": 1400, "carrier_contact_name": "Alex", "carrier_contact_phone": ""}
      }]
    },
    {
      "expect_last_tool_result": {"status": "success"},
      "text": "Perfect, I'll get the confirmation sent over.",
      "tool_calls": [{"id": "end-1", "name": "end_call", "args": {"reason": "agreement"}}]
    }
  ]
}
